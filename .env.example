# =====================================================================
# GROCERY STORE DBMS CONFIGURATION TEMPLATE
# Copy this file to .env and configure for local or Vercel deployment.
# NEVER commit .env to version control.
# =====================================================================

# Flask Application & Security Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
SESSION_COOKIE_SECURE=False

# Database Connection Settings (Local MySQL or Cloud: Aiven, TiDB, PlanetScale, AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=grocery_shop_db

# Manager Credentials (Full DDL/DML access)
MANAGER_DB_USER=shop_manager
MANAGER_DB_PASS=Manager@123

# Clerk Credentials (Restricted POS/Checkout access)
CLERK_DB_USER=shop_clerk
CLERK_DB_PASS=Clerk@123

# Serverless Connection Pool & Timeouts
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=15

# Cloud Database SSL Settings (Optional, e.g. Aiven / AWS RDS)
DB_SSL_CA=
DB_SSL_MODE=
DB_SSL_DISABLED=False

# Optional Caching & Rate-Limiting Storage (defaults to in-memory)
# e.g., rediss://default:password@your-upstash-redis.com:6379
REDIS_URL=

# Google OAuth 2.0 / OpenID Connect Settings
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local dev: http://localhost:5000/auth/google/callback
# For Vercel production: https://your-project.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Access Control & Bootstrapping
ALLOWED_EMAIL_DOMAINS=
INITIAL_MANAGER_EMAIL=admin@example.com
